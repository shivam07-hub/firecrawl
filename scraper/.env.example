# Copy to .env and fill in values

# ── LM Studio (local — no cloud API) ─────────────────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
# Set to the exact model name shown in LM Studio's "Local Server" tab
LM_STUDIO_MODEL=your-model-name-here

# ── Local Firecrawl ───────────────────────────────────────────────────────────
FIRECRAWL_URL=http://localhost:3002

# ── Optional overrides ────────────────────────────────────────────────────────
# PORTALS_PATH=/absolute/path/to/KNOWN_PORTALS.md
# OUTPUT_BASE=/absolute/path/to/All_CSV_Outputs
# WORKDAY_PAGE_SIZE=20
# REQUEST_TIMEOUT=30
# FIRECRAWL_CRAWL_LIMIT=40
# FIRECRAWL_POLL_SECS=90
# LLM_JD_CHAR_LIMIT=2000
