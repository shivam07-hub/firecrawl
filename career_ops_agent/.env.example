# Career Ops Agent — runtime config.
# Supabase creds are auto-read from ../scraper/.env, so you usually only need the key below.

# ── OpenRouter (you supply this at run time) ──────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model slug. Examples:
#   anthropic/claude-sonnet-4   (best quality)
#   google/gemini-2.0-flash-001 (cheap, fast)
#   meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ── Optional overrides ────────────────────────────────────────────────────────
# SUPABASE_URL=https://gipvxuugajkugntwkeiz.supabase.co
# SUPABASE_SERVICE_KEY=...
# CV_PATH=./cv.md
# PROFILE_PATH=./profile.yaml
